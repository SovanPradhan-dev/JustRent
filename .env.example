PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/vehicle-connect
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PUBLIC_BOOKING_ENABLED=false
NEGOTIATED_PRICING_ENABLED=false
LOCATION_RETENTION_DAYS=90
# Optional routing provider. Leave unset to disable route/ETA enrichment.
MAPS_API_KEY=
GEOCODER_ENDPOINT=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=VehicleConnect/1.0 (contact: your-email@example.com)
# Razorpay is intentionally inactive until credentials and webhook are configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
